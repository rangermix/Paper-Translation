{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bilingual-library:render-input:3.0",
  "title": "个人PDF文库 RenderInput",
  "description": "仅PDF来源的内部渲染契约；不是用户导入接口。块引用、覆盖、哈希、原子、多版本由语义验证器检查。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "title": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "notice"
      ]
    },
    "source_revision": {
      "$ref": "#/$defs/source_revision"
    },
    "translation_revision": {
      "$ref": "#/$defs/translation_revision"
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "renderer_version": {
          "type": "string"
        },
        "settings_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "release",
            "draft"
          ]
        }
      },
      "required": [
        "template_id",
        "template_sha256",
        "renderer_version",
        "settings_hash",
        "mode"
      ]
    }
  },
  "required": [
    "schema_version",
    "document",
    "source_revision",
    "translation_revision",
    "render"
  ],
  "$defs": {
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "marks": {
              "type": "array",
              "items": {
                "enum": [
                  "strong",
                  "emphasis",
                  "code"
                ]
              },
              "minItems": 0
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "protected_ref"
            },
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            }
          },
          "required": [
            "type",
            "ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "link"
            },
            "href": {
              "type": "string",
              "pattern": "^(https?://|mailto:)"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "href",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "xref"
            },
            "target_block_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_block_id",
            "label"
          ]
        }
      ]
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "number",
            "math",
            "code",
            "citation",
            "variable"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "storage_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "media_type",
        "sha256",
        "storage_key",
        "byte_size"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pdf"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "coordinate_system": {
          "const": "top-left-points"
        },
        "page_size": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "type",
        "asset_id",
        "page",
        "bbox",
        "coordinate_system",
        "page_size"
      ]
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "raw_start": {
          "type": "integer",
          "minimum": 0
        },
        "raw_end": {
          "type": "integer",
          "minimum": 0
        },
        "replacement": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "raw_start",
        "raw_end",
        "replacement",
        "reviewed",
        "evidence"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "row_span": {
          "type": "integer",
          "minimum": 1
        },
        "column_span": {
          "type": "integer",
          "minimum": 1
        },
        "content_block_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        }
      },
      "required": [
        "row",
        "column",
        "row_span",
        "column_span",
        "content_block_id"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "list_ordered": {
          "type": "boolean"
        },
        "list_index": {
          "type": "integer",
          "minimum": 0
        },
        "code_language": {
          "type": "string"
        },
        "recognition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "original_text": {
              "type": "string"
            }
          },
          "required": [
            "model",
            "revision",
            "original_text"
          ]
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "caption_block_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "minItems": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          },
          "minItems": 0
        },
        "representation": {
          "enum": [
            "structured",
            "image",
            "plain",
            "latex"
          ]
        },
        "comparison_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "comparison_scope": {
          "enum": [
            "page",
            "region"
          ]
        }
      },
      "required": []
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "parent_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "heading",
            "paragraph",
            "list_item",
            "code",
            "math",
            "figure",
            "caption",
            "table",
            "table_cell",
            "footnote",
            "reference"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?$"
        },
        "translatable": {
          "type": "boolean"
        },
        "raw_text": {
          "type": "string"
        },
        "normalized_text": {
          "type": "string"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "normalization_edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edit"
          },
          "minItems": 0
        },
        "source_inline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          },
          "minItems": 0
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "required": [
        "id",
        "order",
        "parent_id",
        "owner_id",
        "kind",
        "language",
        "translatable",
        "raw_text",
        "normalized_text",
        "source_hash",
        "normalization_edits",
        "source_inline",
        "provenance",
        "warnings",
        "attributes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "heading"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "required": [
                  "level"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "figure"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "required": [
                  "asset_id",
                  "caption_block_ids"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "list_item"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "required": [
                  "list_ordered"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "required": [
                  "representation",
                  "caption_block_ids"
                ],
                "oneOf": [
                  {
                    "properties": {
                      "representation": {
                        "const": "structured"
                      }
                    },
                    "required": [
                      "rows",
                      "columns",
                      "cells"
                    ]
                  },
                  {
                    "properties": {
                      "representation": {
                        "const": "image"
                      }
                    },
                    "required": [
                      "asset_id"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "math"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "required": [
                  "representation"
                ]
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "translated",
            "retained",
            "unresolved",
            "fallback"
          ]
        },
        "target_inline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          },
          "minItems": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "review_state": {
          "enum": [
            "not_reviewed",
            "machine_checked",
            "human_reviewed"
          ]
        },
        "reason": {
          "type": "string"
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "human",
                "model",
                "imported",
                "cache",
                "retained",
                "memory"
              ]
            },
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "profile_version": {
              "type": "string"
            },
            "prompt_version": {
              "type": "string"
            },
            "glossary_revision": {
              "type": "string"
            },
            "attempt_id": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "provider",
            "model",
            "profile_version",
            "prompt_version",
            "glossary_revision",
            "attempt_id"
          ]
        },
        "review_record": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reviewed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "target_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "context_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "glossary_revision": {
                  "type": "string"
                },
                "inherited_from": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "origin": {
                  "const": "manual_ui",
                  "description": "个人显式确认的操作来源，不是身份标识"
                }
              },
              "required": [
                "origin",
                "reviewed_at",
                "source_hash",
                "target_hash",
                "context_hash",
                "glossary_revision",
                "inherited_from"
              ]
            }
          ]
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "source_text",
                "source_page"
              ]
            }
          }
        }
      },
      "required": [
        "block_id",
        "source_hash",
        "context_hash",
        "status",
        "target_inline",
        "warnings",
        "review_state",
        "reason",
        "generation",
        "review_record"
      ]
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "kind": {
          "const": "pdf_upload"
        },
        "language": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?$"
        },
        "original_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "config_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "name",
            "version",
            "config_hash"
          ]
        },
        "normalization_version": {
          "type": "string"
        },
        "title_block_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "reading_order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 1
        },
        "protected_atoms": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/protected"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "language",
        "original_asset_id",
        "sha256",
        "created_at",
        "parser",
        "normalization_version",
        "title_block_id",
        "reading_order",
        "assets",
        "protected_atoms",
        "blocks"
      ]
    },
    "translation_revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "source_revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "target_language": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?$"
        },
        "title": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "glossary_revision": {
          "type": "string"
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "human",
                "model",
                "imported",
                "mixed"
              ]
            },
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "prompt_version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "model",
            "prompt_version"
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time"
        },
        "results": {
          "type": "array",
          "items": {
