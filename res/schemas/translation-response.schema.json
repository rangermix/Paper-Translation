{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bilingual-library:model-output:3.0",
  "title": "Provider中模型正文响应；Adapter另提供终止与用量",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "target_inline": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "protected_ref"
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                }
              ]
            },
            "minItems": 1
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "unit_id",
          "target_inline",
          "warnings"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "units"
  ]
}
