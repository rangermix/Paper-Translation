{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bilingual-library:nonblocking:1",
  "$defs": {
    "quality": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "checking",
            "completed",
            "stale",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "important": {
          "default": 0,
          "minimum": 0,
          "title": "Important",
          "type": "integer"
        },
        "general": {
          "default": 0,
          "minimum": 0,
          "title": "General",
          "type": "integer"
        },
        "info": {
          "default": 0,
          "minimum": 0,
          "title": "Info",
          "type": "integer"
        },
        "diagnostic_count": {
          "default": 0,
          "minimum": 0,
          "title": "Diagnostic Count",
          "type": "integer"
        },
        "blocking": {
          "const": false,
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "title": "QualitySummary",
      "type": "object"
    },
    "issue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "enum": [
            "important",
            "general",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "diagnostic_count": {
          "default": 1,
          "minimum": 1,
          "title": "Diagnostic Count",
          "type": "integer"
        },
        "recovery": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "recovered",
            "retained",
            "acknowledged"
          ],
          "title": "Status",
          "type": "string"
        },
        "blocking": {
          "const": false,
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "stage",
        "category",
        "severity",
        "message"
      ],
      "title": "ContentIssue",
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "local",
            "api",
            "historical_unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "models": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Models",
          "type": "array"
        },
        "parser_profile_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Profile Revision"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Version"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "threads": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threads"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "api_protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Protocol"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "config_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Revision"
        },
        "evidence_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Source"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ModelIdentity",
      "type": "object"
    }
  }
}
