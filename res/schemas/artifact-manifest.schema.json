{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bilingual-library:artifact-manifest:3.0",
  "title": "Immutable artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "kind": {
      "enum": [
        "generated",
        "draft",
        "legacy"
      ]
    },
    "source_revision_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "translation_revision_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "template_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "template_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "renderer_version": {
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_required_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "review_label": {
          "type": "string"
        }
      },
      "required": [
        "blockers",
        "unresolved_required_blocks",
        "accepted_warnings",
        "review_label"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "byte_size",
          "media_type"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "source_revision_id",
    "translation_revision_id",
    "template_id",
    "template_sha256",
    "renderer_version",
    "content_digest",
    "created_at",
    "quality_summary",
    "files"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "generated"
          }
        }
      },
      "then": {
        "properties": {
          "source_revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "translation_revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "quality_summary": {
            "properties": {
              "blockers": {
                "const": 0
              },
              "unresolved_required_blocks": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
